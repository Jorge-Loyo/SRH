# ============================================
# PROYECTO SALUD - CONFIGURACIÓN DE AMBIENTE
# ============================================
# Copiar este archivo a .env y ajustar valores para cada ambiente
# ⚠️ IMPORTANTE: .env debe estar en .gitignore (no commitear secretos)

# ============================================
# AMBIENTE
# ============================================
# development, staging, production
NODE_ENV=development

# ============================================
# SERVIDOR
# ============================================
# Puerto del servidor Express
PORT=3000

# Proxy inverso/load balancer (necesario para IPs correctas en audit logs)
# Si el servidor está detrás de Nginx/HAProxy/ALB: TRUST_PROXY=true
TRUST_PROXY=false

# ============================================
# BASE DE DATOS
# ============================================
# Dialecto: mysql, oracle, sqljs (para testing)
DB_DIALECT=mysql

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=proyecto_salud

# Oracle (futuro)
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE=XE
# ORACLE_USER=system
# ORACLE_PASSWORD=oracle

# ============================================
# AUTENTICACIÓN & SEGURIDAD
# ============================================
# 🔴 PRODUCCIÓN: Mínimo 32 caracteres alphanumericos (REQUERIDO)
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-change-this-in-production-at-least-32-chars

# Token JWT expira en 20 minutos (Fase 1: migrado a JWT exclusivo)
JWT_EXPIRES_IN=20m

# 🔴 PRODUCCIÓN: Mínimo 32 caracteres (REQUERIDO para Helmet SameSite cookie)
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-change-this-in-production-at-least-32-chars

# 🔴 PRODUCCIÓN: DEBE ser "true" para cookies seguras vía HTTPS (Fase 1 requerido)
# Validado en envValidator.js en producción
SESSION_SECURE=false
SESSION_SAME_SITE=strict

# Token refresh (mantiene usuarios logueados 7 días)
REFRESH_TOKEN_EXPIRES_IN=7d

# Rate limiting refresh token (Fase 2: 60 req/5min default)
REFRESH_TOKEN_RATE_LIMIT=60

# Rate limiting (intentos fallidos de login)
# Máximo intentos de login por IP en X minutos
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MS=900000  # 15 minutos

# ============================================
# ADMINISTRACIÓN
# ============================================
# Habilitar panel AdminJS
ADMIN_ENABLED=true

# Ruta del panel (default: /admin)
ADMIN_ROOT_PATH=/admin

# Email de admin (para reset de contraseña, notificaciones)
ADMIN_EMAIL=admin@ejemplo.com

# ============================================
# LIMPIEZA AUTOMÁTICA (Schedulers - Fase 2)
# ============================================
# Retener tokens expirados/revocados por X días (se limpian automáticamente)
# Scheduler corre cada 4 horas con monitoring y alertas (Fase 2)
TOKEN_RETENTION_DAYS=30

# Retener logs de auditoría por X días (se limpian automáticamente)
# Scheduler corre cada 24 horas con monitoring y alertas (Fase 2)
AUDIT_RETENTION_DAYS=30

# ============================================
# EXPORTACIÓN DE DATOS
# ============================================
# Máximo número de filas para exportar en CSV (evita OOM)
EXPORT_MAX_BATCH=20000

# ============================================
# LOGGING (Fase 2: Rotación automática)
# ============================================
# Nivel de logging: error, warn, info, http, debug
LOG_LEVEL=info

# Directorio de logs
LOG_DIR=logs

# En producción se guardan logs con rotación automática (Fase 2):
# - logs/app-YYYY-MM-DD.log (general, rotación automática cada 24h, retención 14 días)
# - logs/errors-YYYY-MM-DD.log (solo errores, rotación automática cada 24h, retención 30 días)
# Archivos comprimidos automáticamente, disco nunca se llena
LOG_RETENTION_DAYS=14
LOG_ERROR_RETENTION_DAYS=30

# ============================================
# NOTIFICACIONES (Optional - futuro)
# ============================================
# SMTP para alertas de cleanup scheduler
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alertas@ejemplo.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=alertas@ejemplo.com
# ALERT_EMAIL=ops@ejemplo.com

# ============================================
# DESARROLLO (Solo en development)
# ============================================
# Usar SQL.js en lugar de MySQL (útil para testing sin BD real)
# DB_DIALECT=sqljs

# Modo debug (más logs verbose)
DEBUG=false

# ============================================
# CHECKLIST DE SEGURIDAD PARA PRODUCCIÓN
# ============================================
# Antes de deployar a producción, verificar:
#
# ✅ NODE_ENV=production
# ✅ SESSION_SECURE=true (HTTPS obligatorio)
# ✅ JWT_SECRET (mínimo 32 caracteres, caracteres especiales)
# ✅ SESSION_SECRET (mínimo 32 caracteres, caracteres especiales)
# ✅ DB_PASSWORD (contraseña fuerte, no default "root")
# ✅ TRUST_PROXY=true (si hay proxy/load balancer)
# ✅ ADMIN_EMAIL (email válido)
# ✅ BASE DE DATOS creada y migrada
# ✅ Permisos de archivos correctos (logs directory, etc.)
# ✅ No hay archivos .env committeados (verificar .gitignore)
#
# Ver: Documentacion/SECURITY.md para más detalles
