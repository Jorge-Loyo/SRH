NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# Base de Datos MySQL (Railway / PlanetScale / etc.)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_DIALECT=mysql

# Auth
JWT_SECRET=
AUTH_MODE=db
AUTH_COOKIES=true
AUTH_IDLE_MINUTES=30

# Cleanup & Retention
TOKEN_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=30
