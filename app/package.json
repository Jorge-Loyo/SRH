{
  "name": "proyecto-salud-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Node.js + Express + TypeORM para sistema de salud (MySQL ahora, Oracle luego).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "seed:users": "node scripts/seed-users.js",
    "migrate": "node scripts/run-migrations.js run",
    "migrate:revert": "node scripts/run-migrations.js revert",
    "migrate:show": "node scripts/run-migrations.js show",
    "migrate:diag": "node scripts/run-migrations.js diag",
    "audit:purge": "node scripts/audit-purge.js",
    "load:concursos": "node scripts/load-concursos.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.11.3",
    "node-cache": "^5.1.2",
    "reflect-metadata": "^0.1.13",
    "sanitize-html": "^2.11.0",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.20",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "babel-jest": "^30.2.0",
    "baseline-browser-mapping": "^2.9.16",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "nodemon": "^3.1.0",
    "react-is": "^19.2.3",
    "sql.js": "^1.11.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
