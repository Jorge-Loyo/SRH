{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    // Strict mode PARCIALMENTE habilitado - Validación selectiva
    // ✅ Habilitado: noImplicitAny, strictNullChecks (detecta errores comunes)
    // ✅ Deshabilitado: strict (todo de golpe requeriría 40+ horas refactor)
    "strict": false,
    "noImplicitAny": true,  // ✅ NUEVO: Detecta `any` implícito
    "strictNullChecks": true,  // ✅ NUEVO: Valida null/undefined
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
